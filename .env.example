# Copy this file to .env and fill in your keys. Never commit .env.
GEMINI_API_KEY=
# Main model, and backup models tried in order if it is busy/retired (check with: python check_gemini.py)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest,gemini-flash-latest
# Optional: PlantNet key from https://my.plantnet.org (if empty, Gemini identifies the plant)
PLANTNET_API_KEY=
